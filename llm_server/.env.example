# 백엔드팀이 전달한 공유 키를 그대로 입력 (백엔드 .env의 LLM_EXTRACT_API_KEY와 동일한 값)
LLM_EXTRACT_API_KEY=

# 결과를 콜백으로 보낼 백엔드 주소. 끝에 슬래시(/) 없이.
# 프로덕션: https://ticket-diary.com/api/v1
# 로컬 테스트(백엔드도 로컬에서 띄운 경우): http://localhost:8000/api/v1
BACKEND_BASE_URL=https://ticket-diary.com/api/v1

# vLLM OpenAI 호환 서버 주소. 이 서버(FastAPI 래퍼) 자체가 8000번 포트를 쓰므로
# vLLM은 반드시 다른 포트로 띄우고 그 포트로 채울 것 (예: --port 8001 로 띄웠으면 아래처럼)
VLLM_BASE_URL=http://localhost:8001/v1
# vLLM 기동 시 --api-key를 따로 안 줬으면 EMPTY 그대로 둬도 됨
VLLM_API_KEY=EMPTY
