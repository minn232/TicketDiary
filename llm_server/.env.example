# 백엔드팀이 전달한 공유 키를 그대로 입력 (백엔드 .env의 LLM_EXTRACT_API_KEY와 동일한 값)
LLM_EXTRACT_API_KEY=

# 결과를 콜백으로 보낼 백엔드 주소. 끝에 슬래시(/) 없이.
# 프로덕션: https://ticket-diary.com/api/v1
# 로컬 테스트(백엔드도 로컬에서 띄운 경우): http://localhost:8000/api/v1
BACKEND_BASE_URL=https://ticket-diary.com/api/v1

# vLLM OpenAI 호환 서버 주소. vLLM이 8000번 포트를 쓰기로 확정됐으므로 이 서버(FastAPI
# 래퍼)는 반드시 다른 포트로 띄울 것 (uvicorn main:app --port 8002)
VLLM_BASE_URL=http://localhost:8000/v1
# vLLM 기동 시 --api-key를 따로 안 줬으면 EMPTY 그대로 둬도 됨
VLLM_API_KEY=EMPTY

# 배치 처리 시 모델 호출을 동시에 몇 건까지 허용할지 (crawl/artist/diary 배치 공유).
# 평소 트래픽은 기본값(3)으로 충분하고, 대량 백필처럼 한 번에 몰아서 보낼 때만
# 일시적으로 올리는 용도 - vLLM GPU 메모리 여유에 맞춰 낮은 값부터 점진적으로 테스트할 것
BATCH_CONCURRENCY=3
