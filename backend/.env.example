# Database
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/ticketdiary
SYNC_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/ticketdiary

# JWT
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Kakao Login
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=http://localhost:8000/api/v1/auth/kakao/callback
# 카카오 콘솔 "카카오 로그인 > 보안"에서 Client Secret이 활성화된 경우 필수 (없으면 토큰 교환이 invalid_client(KOE010)로 실패함)
KAKAO_CLIENT_SECRET=

# KOPIS API
KOPIS_API_KEY=
KOPIS_BASE_URL=http://www.kopis.or.kr/openApi/restful

# Setlist.fm API
SETLISTFM_API_KEY=
SETLISTFM_BASE_URL=https://api.setlist.fm/rest/1.0

# Last.fm API (아티스트 추천용 유사 아티스트/장르 태그)
LASTFM_API_KEY=
# artist.getSimilar/getTopTags 등 공개 GET 메서드만 쓰는 동안은 서명이 필요 없어서 코드가
# 안 읽음(참고용으로만 보관) - 나중에 서명이 필요한 메서드(예: 유저 인증 연동)를 쓰게 되면 필요
LASTFM_SHARED_SECRET=
LASTFM_BASE_URL=https://ws.audioscrobbler.com/2.0

# Google Vision API (OCR)
GOOGLE_VISION_API_KEY=

# LLM팀 연동
LLM_EXTRACT_API_KEY=
LLM_CRAWL_URL=
# 공연명+포스터 -> 아티스트 추출 요청 웹훅 (인증은 LLM_EXTRACT_API_KEY 재사용)
LLM_ARTIST_URL=
# 한줄평 -> 공연 일기 생성 요청 (동기 호출, 인증은 LLM_EXTRACT_API_KEY 재사용)
LLM_DIARY_URL=
# LLM팀 GPU pod을 매일 KST 00시 전후로 자동 시작/정지시키기 위한 RunPod REST API 인증
# (비용 절감용, 둘 다 비워두면 트리거 자체를 안 함 - 로컬 개발 시엔 안 채워도 무방)
RUNPOD_API_KEY=
RUNPOD_POD_ID=
# pod을 깨운 뒤 SSH로 접속해서 start_all.sh(vLLM+llm_server+cloudflared 기동)를 원격 실행하기
# 위한 정보. RUNPOD_SSH_HOST를 비워두면 pod만 켜고 원격 실행은 건너뜀(LLM팀이 수동으로 띄우는
# 예전 방식). 개인키는 이 자동화 전용으로 새로 만들어서 pod의 ~/.ssh/authorized_keys에
# 등록해두고(개인 SSH 키 재사용 금지), 그 개인키 파일 경로를 RUNPOD_SSH_KEY_PATH에 지정
RUNPOD_SSH_HOST=
RUNPOD_SSH_PORT=22
RUNPOD_SSH_USER=root
RUNPOD_SSH_KEY_PATH=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=ticketdiary-images

# Firebase (푸시 알림)
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json

# App
APP_ENV=development
APP_DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]
